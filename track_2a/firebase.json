{
  "hosting": {
    "site": "zusage",
    "public": "src/frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/api/**", "run": {"serviceId": "zusage", "region": "europe-west1"}},
      {"source": "/v1/**", "run": {"serviceId": "zusage", "region": "europe-west1"}},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}]},
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "X-Frame-Options", "value": "DENY"}]}
    ]
  }
}
