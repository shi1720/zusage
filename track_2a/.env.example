# --- Apertus endpoint (Hack Apertus template variables) ---------------------
# Any OpenAI-compatible server hosting Apertus 1.5 works: the Hack Apertus gateway
# (LLM_NAME=apertus-v1.5-8b), CSCS (https://api.inference.cscs.ch/v1, swiss-ai/Apertus-v1.5-8B),
# Public AI (https://api.publicai.co/v1), your own vLLM / llama.cpp / Ollama.
# Leave LLM_BASE_URL empty to run the offline demo coach (no LLM, rule-based).
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=
LLM_API_KEY=

# --- Optional product settings --------------------------------------------
# ZUSAGE_PORT=8080
# ZUSAGE_SEED_DEMO=true          # seed the fictional demo class (disable in production)
# ZUSAGE_SECRET_KEY=             # session signing key (auto-generated & persisted if empty)
# ZUSAGE_COOKIE_SECURE=false     # set true behind HTTPS
# ZUSAGE_TRANSCRIPT_RETENTION_DAYS=180

# Optional hosted natural speech. Leave disabled for local deployments.
ZUSAGE_TTS_ENABLED=false
ZUSAGE_TTS_PROJECT=
